    {
      "id": "js-game-loop",
      "title": "Smooth JavaScript game loop",
      "tool": "code-snippet-generator",
      "character": "Ember",
      "description": "A requestAnimationFrame loop with a delta time so movement is the same speed on a fast Chromebook and a slow laptop.",
      "filename": "game-loop.js",
      "type": "text/javascript",
      "body": [
        "const canvas = document.querySelector('canvas');",
        "const ctx = canvas.getContext('2d');",
        "",
        "const player = { x: 40, y: 40, speed: 140, size: 28 };",
        "const keys = new Set();",
        "",
        "addEventListener('keydown', (e) => keys.add(e.key.toLowerCase()));",
        "addEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));",
        "",
        "let last = performance.now();",
        "",
        "function update(dt) {",
        "  if (keys.has('arrowleft') || keys.has('a')) player.x -= player.speed * dt;",
        "  if (keys.has('arrowright') || keys.has('d')) player.x += player.speed * dt;",
        "  if (keys.has('arrowup') || keys.has('w')) player.y -= player.speed * dt;",
        "  if (keys.has('arrowdown') || keys.has('s')) player.y += player.speed * dt;",
        "  player.x = Math.max(0, Math.min(canvas.width - player.size, player.x));",
        "  player.y = Math.max(0, Math.min(canvas.height - player.size, player.y));",
        "}",
        "",
        "function draw() {",
        "  ctx.clearRect(0, 0, canvas.width, canvas.height);",
        "  ctx.fillStyle = '#f5a623';",
        "  ctx.fillRect(player.x, player.y, player.size, player.size);",
        "}",
        "",
        "function frame(now) {",
        "  const dt = Math.min(0.05, (now - last) / 1000);",
        "  last = now;",
        "  update(dt);",
        "  draw();",
        "  requestAnimationFrame(frame);",
        "}",
        "",
        "requestAnimationFrame(frame);"
      ]
    },
    {
      "id": "pointer-drag",
      "title": "Drag with mouse, finger or pen",
      "tool": "code-snippet-generator",
      "character": "Pip",
      "description": "One Pointer Events handler that works the same for a mouse, a touch screen and a stylus.",
      "filename": "pointer-drag.js",
      "type": "text/javascript",
      "body": [
        "const board = document.querySelector('#board');",
        "let dragging = false;",
        "",
        "function pointFrom(event) {",
        "  const box = board.getBoundingClientRect();",
        "  return {",
        "    x: event.clientX - box.left,",
        "    y: event.clientY - box.top,",
        "    pressure: event.pressure || 0,",
        "    type: event.pointerType",
        "  };",
        "}",
        "",
        "board.style.touchAction = 'none';",
        "",
        "board.addEventListener('pointerdown', (event) => {",
        "  dragging = true;",
        "  board.setPointerCapture(event.pointerId);",
        "  paint(pointFrom(event));",
        "});",
        "",
        "board.addEventListener('pointermove', (event) => {",
        "  if (!dragging) return;",
        "  event.preventDefault();",
        "  paint(pointFrom(event));",
        "});",
        "",
        "board.addEventListener('pointerup', () => { dragging = false; });",
        "board.addEventListener('pointercancel', () => { dragging = false; });",
        "",
        "function paint(point) {",
        "  const dot = document.createElement('span');",
        "  dot.className = 'dot';",
        "  dot.style.left = point.x + 'px';",
        "  dot.style.top = point.y + 'px';",
        "  dot.style.opacity = 0.4 + point.pressure;",
        "  board.appendChild(dot);",
        "}"
      ]
    },
