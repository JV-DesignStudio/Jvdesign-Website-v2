{
  "studio": "/workshops/mugen-mod-studio.html",
  "pages": {
    "mugen-basics-workshop": [
      {
        "n": 1,
        "school": "Open the Studio Fighter tab and read the starter def. No MUGEN install.",
        "tab": "Fighter",
        "home": "Install MUGEN 1.1 and open mugen.exe.",
        "file": "mugen.exe",
        "section": "Install",
        "line": "MUGEN 1.1",
        "check": "MUGEN launches to the main menu."
      },
      {
        "n": 2,
        "school": "Read the Files tab checklist to see the folders a fighter needs.",
        "tab": "Files",
        "home": "Learn the chars, stages and data folders.",
        "file": "mugen/",
        "section": "Folders",
        "line": "chars/ stages/ data/",
        "check": "You can find each folder."
      },
      {
        "n": 3,
        "school": "Use the Fighter def builder to name a fighter.",
        "tab": "Fighter",
        "home": "Add a character folder.",
        "file": "chars/MyFighter/MyFighter.def",
        "section": "[Info]",
        "line": "name = My Fighter",
        "check": "The fighter appears on the select screen."
      },
      {
        "n": 4,
        "school": "Open the Stage tab and set a stage name and music.",
        "tab": "Stage",
        "home": "Add a stage and its music.",
        "file": "stages/MyStage.def",
        "section": "[Music]",
        "line": "bgmusic = sound/MyStage.mp3",
        "check": "The stage loads with music."
      },
      {
        "n": 5,
        "school": "In Files, change the fighter name in the def preview.",
        "tab": "Files",
        "home": "Edit the name and file list.",
        "file": "MyFighter.def",
        "section": "[Files]",
        "line": "cmd = MyFighter.cmd",
        "check": "The new name shows on select."
      },
      {
        "n": 6,
        "school": "Open Export and download the starter folder.",
        "tab": "Export",
        "home": "Plan the roster in select.def.",
        "file": "data/select.def",
        "section": "[Characters]",
        "line": "MyFighter, stages/MyStage.def",
        "check": "The roster lists your fighter."
      }
    ],
    "mugen-ai-workshop": [
      {
        "n": 1,
        "school": "Open the Files tab and read the starter .cns file. No install.",
        "tab": "Files",
