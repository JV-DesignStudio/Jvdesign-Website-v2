config_version=5

[application]

config/name="Barrel Blast"
config/description="Starter template for the JVDesignStudio 'Barrel Blast!' Godot 4 workshop.\nA Donkey Kong-style arcade game — dodge rolling barrels and reach the top!\nFollow the workshop at jvdesignstudio.co.uk!"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=480
window/size/viewport_height=640
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
