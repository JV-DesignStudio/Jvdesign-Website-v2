-- My First Defold Game: Star Catcher starter
-- Attach this script to a game object with a sprite, then work through the canvas steps.

function init(self)
    self.bx = 0.5
    self.score = 0
end

function update(self, dt)
    -- Step 2: read the left and right actions and move self.bx.
    -- Step 3: move the star down and respawn it at the top.
    -- Step 4: check the star and catcher overlap.
    -- Step 5 and 6: score, speed ramp and the next round.
end

function on_input(self, action_id, action)
    if action_id == hash("left") then
        self.bx = math.max(0, self.bx - 0.01)
    end
    if action_id == hash("right") then
        self.bx = math.min(1, self.bx + 0.01)
    end
end
