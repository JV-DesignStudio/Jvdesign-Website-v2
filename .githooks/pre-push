#!/bin/sh
# Pre-push guard: blocks push if generated files drift from source.
# Run `npm run build` + `git add -A` before pushing; CI runs the same check.
set -e
echo "pre-push: checking generated drift (full)..."
if command -v node >/dev/null 2>&1; then
  node scripts/check-generated-drift.js 2>&1 | cat
  if [ $? -ne 0 ]; then
    echo ""
    echo "Push blocked: generated files drift."
    echo "  Run: npm run build"
    echo "       git add -A && git diff --cached --stat  # review"
    echo "       git commit --amend or git commit -m \"regenerate\""
    echo "  Or:  node scripts/check-generated-drift.js --fix && git add -A"
    exit 1
  fi
  node scripts/validate-public-boundary.js 2>&1 | cat
fi
exit 0
