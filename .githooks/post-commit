#!/bin/sh
# post-commit: if devlog-data.js was touched in this commit, regenerate the
# comms queue (social cards, INDEX.md, board cards). Files are generated but
# NOT staged - review the output then add and commit manually (A255).

if git diff-tree --no-commit-id -r HEAD --name-only | grep -q "devlog-data\.js"; then
  echo "[post-commit] devlog-data.js changed - running comms:queue..."
  npm run comms:queue --silent && echo "[post-commit] comms:queue done - review social-posts/queue/ then stage + commit"
fi
exit 0
