#!/bin/sh
# Pre-commit guard: blocks NEW em/en dashes in the lines you are committing.
# It never edits files and never stages anything (A255: no automated content
# rewrites without a reviewed diff). Only your staged added lines are checked,
# so other people's unstaged work is never touched.
# Activate with: git config core.hooksPath .githooks (already set)
# Bypass once: git commit --no-verify

node scripts/check-staged-dashes.js || {
  echo ""
  echo "  Fix: review staged lines above, replace em/en dash with \" - \" or comma/colon."
  echo "  Quick fix (review diff before committing):"
  echo "    node F:/Website/studio-workspace/check-dashes.cjs --fix"
  echo "    git diff   # review"
  echo "  Bypass once: git commit --no-verify"
  exit 1
}

# Scope guard: block broad `git add -A` sweeps that bundle other agents' work.
# Override once with ALLOW_BROAD_COMMIT=1 (or git commit --no-verify).
node scripts/check-staged-scope.js || exit 1

# Dev log guard: bot drafts must stay private, and every new post needs a real
# captured image and working links. Only runs when devlog-data.js is staged.
if git diff --cached --name-only | grep -q '^devlog-data.js$'; then
  node report-devlog-drafts.js || exit 1
  node tests/devlog-media.js || exit 1
fi

exit 0
