{
    "name": "My First Defold Game",
    "dependencies": [],
    "window": {
        "title": "My First Defold Game",
        "width": 960,
        "height": 640,
        "high_dpi": false
    },
    "display": {
        "width": 960,
        "height": 640,
        "low_dpi": true,
        "samples": 0,
        "fullscreen": false,
        "display_profile": 0
    },
    "sound": {
        "max_sound_data": 128,
        "max_sound_buffers": 32,
        "max_sound_sources": 16
    },
    "render": {
        "script": "/builtins/render/default.render_script"
    },
    "scripts": {
        "bootstrap": "/main/main.collection"
    },
    "physics": {
        "type": 2d,
        "gravity_y": 0,
        "debug": false
    },
    "input": {
        "enable_game_pad": false
    }
}
