-- ============================================
-- DEFOLD MAIN SCRIPT - STARTER TEMPLATE
-- ============================================
-- This is a minimal main script for Defold.
-- Attach this to a game object in your main
-- collection to handle game logic.
--
-- Key functions:
--   init()      - Called once when script starts
--   update()    - Called every frame (60 Hz)
--   on_message() - Handles messages from other scripts
-- ============================================

-- -------------------------------------------
-- INITIALIZATION
-- -------------------------------------------
-- Called once when the script is initialized
-- Set up game state, load resources, etc.
function init(self)
    -- Initialize game state variables
    self.score = 0
    self.game_over = false
    self.timer = 0
    
    -- Log to console
    print("Game initialized!")
end

-- -------------------------------------------
-- UPDATE LOOP
-- -------------------------------------------
-- Called every frame (60 times per second)
-- dt = delta time (time since last frame)
function update(self, dt)
    -- Don't update if game is over
    if self.game_over then
        return
    end
    
    -- Update timer
    self.timer = self.timer + dt
    
    -- Handle input here
    -- Example: if action.pressed then ...
    
    -- Update game objects here
    
    -- Check win/lose conditions
    
    -- Update score display if needed
end

-- -------------------------------------------
-- MESSAGE HANDLING
-- -------------------------------------------
-- Handle messages from other scripts
-- Common messages:
--   "start_game" - Begin a new game
--   "game_over"  - End the game
--   "score"      - Update score
function on_message(self, message_id, message, sender)
    -- Handle different message types
    if message_id == hash("start_game") then
        self.game_over = false
        self.score = 0
        self.timer = 0
        print("Game started!")
        
    elseif message_id == hash("game_over") then
        self.game_over = true
        print("Game over! Final score: " .. self.score)
        
    elseif message_id == hash("score") then
        self.score = self.score + (message.points or 1)
        print("Score: " .. self.score)
        
    else
        print("Unknown message: " .. tostring(message_id))
    end
end

-- -------------------------------------------
-- INPUT HANDLING
-- -------------------------------------------
-- Handle input actions (optional)
-- Define actions in /input/game.input_binding
function on_input(self, action_id, action)
    -- Handle input actions
    if action_id == hash("left") then
        -- Move left
    elseif action_id == hash("right") then
        -- Move right
    elseif action_id == hash("up") then
        -- Move up or jump
    elseif action_id == hash("down") then
        -- Move down
    elseif action_id == hash("action") then
        -- Main action (shoot, interact, etc.)
    end
end

-- -------------------------------------------
-- FINALIZE
-- -------------------------------------------
-- Called when script is destroyed
-- Clean up resources here
function finalize(self)
    print("Script finalized")
end
