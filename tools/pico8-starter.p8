pico-8 cartridge // http://www.pico-8.com
version 42
__lua__

-- ============================================
-- PICO-8 STARTER CARTRIDGE
-- ============================================
-- This is a minimal starter template for
-- PICO-8 game development. Open this file
-- in PICO-8 or any text editor to begin.
--
-- Lua code goes here (lines starting with __lua__)
-- ============================================

-- -------------------------------------------
-- GAME STATE
-- -------------------------------------------
local message = "Hello World!"
local timer = 0
local bg_color = 0  -- black

-- -------------------------------------------
-- _init() - Called once when game starts
-- -------------------------------------------
function _init()
  -- Initialize game state here
  timer = 0
  message = "Hello World!"
end

-- -------------------------------------------
-- _update() - Called 60 times per second
-- -------------------------------------------
function _update()
  timer += 1
  
  -- Flash background color every 30 frames
  if timer % 30 == 0 then
    bg_color = (bg_color + 1) % 16
  end
end

-- -------------------------------------------
-- _draw() - Called after _update()
-- -------------------------------------------
function _draw()
  -- Clear screen with current background color
  cls(bg_color)
  
  -- Draw centered text
  local text_color = 7  -- white
  local msg = message
  local x = 64 - #msg * 2  -- center horizontally
  local y = 60  -- center vertically
  
  print(msg, x, y, text_color)
  
  -- Draw timer in corner
  print("t:" .. timer, 2, 2, 12)
  
  -- Draw instructions
  print("press any key!", 32, 100, 8)
end

-- -------------------------------------------
-- _btn() - Input handler (optional)
-- -------------------------------------------
function _btnp(b)
  if b == 0 then
    message = "left pressed!"
  elseif b == 1 then
    message = "right pressed!"
  elseif b == 2 then
    message = "up pressed!"
  elseif b == 3 then
    message = "down pressed!"
  elseif b == 4 then
    message = "z button!"
  elseif b == 5 then
    message = "x button!"
  end
end

