config_version=5

[application]

config/name="Fairy Survivors"
config/description="Starter template for the JVDesignStudio 'Fairy Survivors!' Godot 4 workshop.\nA survivor-style game — move the fairy, auto-shoot sparkles, survive the bugs!\nFollow the workshop at jvdesignstudio.co.uk!"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
