{
  "name": "JVDS Arcade",
  "short_name": "Arcade",
  "description": "Every JVDesignStudio game in one place, with one profile carrying your XP, level, streak and best scores across all of them.",
  "id": "https://jvdesignstudio.co.uk/arcade.html",
  "start_url": "/arcade.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0b10",
  "theme_color": "#0a0b10",
  "lang": "en",
  "dir": "ltr",
  "categories": ["games", "entertainment", "kids"],
  "icons": [
    {
      "src": "icons/arcade-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/arcade-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/arcade-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse games",
      "short_name": "Play",
      "description": "Open the game launcher",
      "url": "/arcade.html#play"
    },
    {
      "name": "Your goals",
      "short_name": "Goals",
      "description": "See your achievements",
      "url": "/arcade.html#goals"
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
