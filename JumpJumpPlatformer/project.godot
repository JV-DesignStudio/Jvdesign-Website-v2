config_version=5

[application]

config/name="Jump Jump Platformer"
config/description="Starter template for the JVDesignStudio 'Jump Jump!' Godot 4 workshop.\nA Mario-style platformer with running, jumping, enemies, coins and a goal.\nFollow the workshop at jvdesignstudio.co.uk!"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
