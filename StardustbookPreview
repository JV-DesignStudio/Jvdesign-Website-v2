<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stardust's Cosmic Adventure</title>
    <style>
        /* ALL YOUR STYLES HERE */
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #050510; font-family: 'Comic Sans MS', cursive; }
        #book-container { position: relative; width: 100vw; height: 100vh; display: flex; justify-content: center; align-items: center; }
        
        #background-layer { 
            position: absolute; top: 0; left: 0; width: 100%; height: 100%; 
            background-size: cover; background-position: center; transition: 1s; z-index: 1; 
        }

        #stardust { 
            position: absolute; font-size: 80px; cursor: pointer; z-index: 5; 
            transition: 0.5s; filter: drop-shadow(0 0 15px gold); user-select: none; top: 40%; 
        }

        #ui-layer { position: absolute; bottom: 30px; z-index: 10; text-align: center; width: 90%; }
        
        #text-box { 
            background: rgba(0, 0, 0, 0.7); padding: 15px; border-radius: 15px; 
            color: white; border: 2px solid gold; margin-bottom: 10px; 
        }

        .nav-buttons button { 
            padding: 10px 25px; font-size: 18px; margin: 5px; cursor: pointer; 
            border-radius: 50px; border: none; background: gold; font-weight: bold; 
        }

        /* The Back Button */
        #back-to-site {
            position: absolute; top: 20px; left: 20px; z-index: 20;
            padding: 10px 15px; background: rgba(255,255,255,0.2); color: white;
            text-decoration: none; border-radius: 10px; font-size: 14px; border: 1px solid white;
        }

        /* Animations */
        .spin { transform: rotate(360deg) scale(1.2); }
        .flash { animation: flashEffect 0.6s; }
        @keyframes flashEffect { 0% { filter: brightness(1); } 50% { filter: brightness(8); } 100% { filter: brightness(1); } }
    </style>
</head>
<body>

    <a id="back-to-site" href="content_hub.html">⬅ Back to Content Hub</a>

    <div id="book-container">
        <div id="background-layer"></div>
        <div id="stardust" onclick="handleInteraction()">✨</div>
        
        <div id="ui-layer">
            <div id="text-box">
                <h1 id="page-text">Stardust's Cosmic Adventure</h1>
                <p id="instruction-text">Click Stardust to begin!</p>
            </div>
            <div class="nav-buttons">
                <button onclick="changePage(-1)">⬅ Back</button>
                <button onclick="changePage(1)">Next ➡</button>
            </div>
        </div>
    </div>

    <script>
        /* ALL YOUR LOGIC HERE */
        let currentPage = 0;
        const bookData = [
            { text: "Stardust's Cosmic Adventure", instr: "Click Stardust!", img: "page1.jpg", action: "spin" },
            { text: "In the faraway corners of the universe, there was a tiny speck named Stardust.", instr: "Look at the golden tail!", img: "page2.jpg", action: "none" },
            { text: "Stardust danced through the cosmos, weaving between comets and clouds.", instr: "Click to twirl!", img: "page3.jpg", action: "spin" },
            { text: "The stars whispered, 'You are a piece of everything.'", instr: "Listen...", img: "page4.jpg", action: "none" },
            { text: "Through swirls of gas and bursts of light, Stardust saw stars being born.", instr: "Hot and bright!", img: "page5.jpg", action: "none" },
            { text: "Suddenly, the sky flashed! A supernova!", instr: "CLICK STARDUST TO EXPLODE!", img: "page6.jpg", action: "flash" },
            { text: "Waves of color and light rushed past.", instr: "So powerful...", img: "page7.jpg", action: "none" },
            { text: "Around a young star, rings of dust began to swirl.", instr: "Spin with the dust!", img: "page8.jpg", action: "spin" },
            { text: "We're forming something new! the pieces whispered.", instr: "Twirl along!", img: "page9.jpg", action: "spin" },
            { text: "Planets spun into being. Big ones with rings, tiny rocky ones!", instr: "Click to spin planets!", img: "page10.jpg", action: "spin" },
            { text: "One planet waved with rings, another spun fast with storms.", instr: "You helped them grow!", img: "page11.jpg", action: "none" },
            { text: "Stardust passed icy worlds and fiery ones.", instr: "Ice and fire...", img: "page12.jpg", action: "none" },
            { text: "The journey continued through the deep blue space.", instr: "Exploring...", img: "page13.jpg", action: "none" },
            { text: "The universe felt vast, but Stardust felt home.", instr: "Peaceful...", img: "page14.jpg", action: "none" },
            { text: "Every sparkle in the sky was a story.", instr: "Find your story...", img: "page15.jpg", action: "none" },
            { text: "The cosmic dance never ends.", instr: "Keep dancing!", img: "page16.jpg", action: "spin" },
            { text: "You are a piece of everything and everyone.", instr: "The End", img: "page17.jpg", action: "flash" }
        ];

        function updatePage() {
            const p = bookData[currentPage];
            document.getElementById('page-text').innerText = p.text;
            document.getElementById('instruction-text').innerText = p.instr;
            // This assumes your images are in a folder called 'images'
            document.getElementById('background-layer').style.backgroundImage = `url('images/${p.img}')`;
            document.getElementById('stardust').className = ""; 
        }

        function handleInteraction() {
            const act = bookData[currentPage].action;
            const s = document.getElementById('stardust');
            const b = document.getElementById('background-layer');
            if (act === "spin") s.classList.add('spin');
            if (act === "flash") b.classList.add('flash');
            setTimeout(() => { s.classList.remove('spin'); b.classList.remove('flash'); }, 1000);
        }

        function changePage(step) {
            currentPage += step;
            if (currentPage < 0) currentPage = 0;
            if (currentPage >= bookData.length) currentPage = 0;
            updatePage();
        }
        updatePage();
    </script>
</body>
</html>