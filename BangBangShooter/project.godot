config_version=5

[application]

config/name="Bang Bang Shooter"
config/description="Starter template for the JVDesignStudio 'Bang Bang!' Godot 4 workshop.\nA top-down twin-stick shooter — move with keyboard, aim with mouse, click to shoot!\nFollow the workshop at jvdesignstudio.co.uk!"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"

[input]

shoot={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_index":1,"factor":1.0,"pressed":false)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
