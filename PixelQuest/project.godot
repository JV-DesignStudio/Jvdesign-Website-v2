config_version=5

[application]

config/name="Pixel Quest"
config/description="Starter template for the JVDesignStudio 'Pixel Quest!' Godot 4 workshop.\nA top-down dungeon adventure — swing your sword, find the key, unlock the door!\nFollow the workshop at jvdesignstudio.co.uk!"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=576
window/size/viewport_height=576
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
