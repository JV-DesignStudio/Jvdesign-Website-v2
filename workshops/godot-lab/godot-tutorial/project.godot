; Star Collector - the finished Godot version of the browser build.
; Open this project in the Godot 4 editor, or load it in the JVDS Godot Lab.

config_version=5

[application]

config/name="Star Collector"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=400
window/size/viewport_height=400
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
