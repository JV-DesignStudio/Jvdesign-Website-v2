; Traffic Dash - a Godot 4 project for the JVDS Godot Lab.
; Open this folder in the Godot editor, or load it in the browser Lab.

config_version=5

[application]

config/name="Traffic Dash"
config/description="Dodge traffic for 45 seconds and bank the finish bonus."
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
