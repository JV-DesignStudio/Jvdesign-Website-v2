          "initialCode": "function applyGravity(entity, gravity) {\n  // Modify entity.vy\n}\n",
          "testCases": [
            {
              "description": "Adds gravity value to entity.vy",
              "assertion": "const p = { vy: 2 }; applyGravity(p, 0.5); p.vy === 2.5"
            }
          ]
        },
        {
          "id": "node-202",
          "title": "Velocity Clamp",
          "mascot": "Pip",
          "xp": 110,
          "prerequisites": ["node-201"],
          "briefing": "Write a function <code>clampSpeed(entity, maxSpeed)</code> that clamps <code>entity.vy</code> so it never exceeds <code>maxSpeed</code>.",
          "initialCode": "function clampSpeed(entity, maxSpeed) {\n  // Clamp entity.vy to maxSpeed\n}\n",
          "testCases": [
            {
              "description": "Does not exceed maxSpeed",
              "assertion": "const e = { vy: 20 }; clampSpeed(e, 10); e.vy === 10"
            },
            {
              "description": "Does not change if under maxSpeed",
              "assertion": "const e2 = { vy: 5 }; clampSpeed(e2, 10); e2.vy === 5"
            }
          ]
        },
        {
