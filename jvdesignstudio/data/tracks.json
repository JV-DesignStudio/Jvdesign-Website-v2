          "title": "AABB Collision",
          "mascot": "Pip",
          "xp": 130,
          "prerequisites": ["node-202"],
          "briefing": "Write <code>isColliding(a, b)</code> that returns true if two axis-aligned rectangles overlap. Each has <code>x, y, w, h</code>.",
          "initialCode": "function isColliding(a, b) {\n  // AABB check\n}\n",
          "testCases": [
            {
              "description": "Detects overlap",
              "assertion": "isColliding({x:0,y:0,w:10,h:10}, {x:5,y:5,w:10,h:10}) === true"
            },
            {
              "description": "No overlap",
              "assertion": "isColliding({x:0,y:0,w:10,h:10}, {x:20,y:20,w:10,h:10}) === false"
            }
          ]
        }
