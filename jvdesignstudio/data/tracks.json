          "title": "Array Armoury",
          "mascot": "Lumo",
          "xp": 90,
          "prerequisites": ["node-103"],
          "briefing": "Write a function <code>doubleAll(arr)</code> that returns a new array with every element multiplied by 2.",
          "initialCode": "function doubleAll(arr) {\n  // Return new array with each element doubled\n}\n",
          "testCases": [
            {
              "description": "doubleAll([1,2,3]) returns [2,4,6]",
              "assertion": "JSON.stringify(doubleAll([1,2,3])) === JSON.stringify([2,4,6])"
            },
            {
              "description": "doubleAll([0,5]) returns [0,10]",
              "assertion": "JSON.stringify(doubleAll([0,5])) === JSON.stringify([0,10])"
            }
          ]
        },
