          "mascot": "Lumo",
          "xp": 75,
          "prerequisites": ["node-101"],
          "briefing": "Create a function <code>canPassGate(keyCard)</code> that returns <code>true</code> if <code>keyCard === 'GOLD'</code>, otherwise <code>false</code>.",
          "initialCode": "function canPassGate(keyCard) {\n  // Return true if keyCard is 'GOLD'\n}\n",
          "testCases": [
            {
              "description": "canPassGate('GOLD') returns true",
              "assertion": "canPassGate('GOLD') === true"
            },
            {
              "description": "canPassGate('SILVER') returns false",
              "assertion": "canPassGate('SILVER') === false"
            }
          ]
        },
        {
