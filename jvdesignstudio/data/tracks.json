          "briefing": "Write a function <code>getFullName(person)</code> that takes an object with <code>first</code> and <code>last</code> properties and returns the full name as a string.",
          "initialCode": "function getFullName(person) {\n  // Return 'FirstName LastName'\n}\n",
          "testCases": [
            {
              "description": "Returns 'Ada Lovelace'",
              "assertion": "getFullName({ first: 'Ada', last: 'Lovelace' }) === 'Ada Lovelace'"
            },
            {
              "description": "Returns 'Grace Hopper'",
              "assertion": "getFullName({ first: 'Grace', last: 'Hopper' }) === 'Grace Hopper'"
            }
          ]
        }
