          "mascot": "Lumo",
          "xp": 80,
          "prerequisites": ["node-102"],
          "briefing": "Write a function <code>sumTo(n)</code> that returns the sum of all integers from 1 to <code>n</code> inclusive.",
          "initialCode": "function sumTo(n) {\n  // Sum from 1 to n\n}\n",
          "testCases": [
            {
              "description": "sumTo(5) returns 15",
              "assertion": "sumTo(5) === 15"
            },
            {
              "description": "sumTo(10) returns 55",
              "assertion": "sumTo(10) === 55"
            },
            {
              "description": "sumTo(1) returns 1",
              "assertion": "sumTo(1) === 1"
            }
          ]
        },
        {
