{
  "id": "jv-engine-starter",
  "title": "JV-Engine Starter Track",
  "mascot": "Guide",
  "mascotAvatar": "🚀",
  "mascotRole": "Engine Guide",
  "description": "A minimal example track showing the JV-Engine quest format.",
  "nodes": [
    {
      "id": "starter-01",
      "title": "Hello, World!",
      "briefing": "<p>The classic first quest. Write a function called <code>greet</code> that returns the string <code>'hello'</code>.</p>",
      "initialCode": "function greet() {\n  // return the string 'hello'\n}",
      "xp": 50,
      "prerequisites": [],
      "testCases": [
        { "description": "greet() returns 'hello'", "assertion": "greet() === 'hello'" }
      ]
    },
    {
      "id": "starter-02",
      "title": "Add Two Numbers",
      "briefing": "<p>Write a function <code>add(a, b)</code> that returns the sum of two numbers.</p>",
      "initialCode": "function add(a, b) {\n  // return a + b\n}",
      "xp": 75,
      "prerequisites": ["starter-01"],
      "testCases": [
        { "description": "add(2, 3) returns 5",    "assertion": "add(2, 3) === 5"    },
        { "description": "add(-1, 1) returns 0",   "assertion": "add(-1, 1) === 0"   },
        { "description": "add(0, 0) returns 0",    "assertion": "add(0, 0) === 0"    }
      ]
    },
    {
      "id": "starter-03",
      "title": "FizzBuzz Classic",
      "briefing": "<p>Write <code>fizzBuzz(n)</code>. Return <code>'Fizz'</code> if divisible by 3, <code>'Buzz'</code> if by 5, <code>'FizzBuzz'</code> if by both, otherwise return <code>n</code> as a string.</p>",
      "initialCode": "function fizzBuzz(n) {\n  // your logic here\n}",
      "xp": 100,
      "prerequisites": ["starter-02"],
      "testCases": [
        { "description": "fizzBuzz(3) === 'Fizz'",     "assertion": "fizzBuzz(3) === 'Fizz'"     },
        { "description": "fizzBuzz(5) === 'Buzz'",     "assertion": "fizzBuzz(5) === 'Buzz'"     },
        { "description": "fizzBuzz(15) === 'FizzBuzz'","assertion": "fizzBuzz(15) === 'FizzBuzz'" },
        { "description": "fizzBuzz(7) === '7'",        "assertion": "fizzBuzz(7) === '7'"         }
      ]
    }
  ]
}
